      "plan.md": {
        "sha256": "542070a74a5b3fdc9d0f2dca73ae11656ba9536160f79ce1f5dec7058d042c91",
        "text": "# 虚构图片上传服务技术方案\n- R1: 远端成功但响应超时后，重试不能产生重复对象。\n- R2: 普通成功请求必须返回已保存对象的 ID。\n- R3: 真实存储供应商必须保证幂等键至少保留 24 小时。\n\n本方案暂不处理并发请求、持久化恢复、认证与权限。所有数据均为虚构。\n"
      },
      "service.py": {
        "sha256": "e158d520ce7bb00ea70ccd9365c9ce6e686b2698fa089f2af0bce444d820072c",
        "text": "class LostResponse(Exception):\n    pass\n\nclass FakeStorage:\n    \"\"\"Test double: first save succeeds remotely, then its response is lost.\"\"\"\n    def __init__(self, lose_first=False):\n        self.objects = []\n        self.keys = {}\n        self.lose_first = lose_first\n\n    def put(self, payload, key=None):\n        if key is not None and key in self.keys:\n            return self.keys[key]\n        identifier = len(self.objects) + 1\n        self.objects.append(payload)\n        if key is not None:\n            self.keys[key] = identifier\n        if self.lose_first:\n            self.lose_first = False\n            raise LostResponse('saved remotely; response lost')\n        return identifier\n\ndef upload(storage, payload, request_id):\n    for attempt in range(2):\n        try:\n            return storage.put(payload)  # BUG: retry has no stable identity\n        except LostResponse:\n            if attempt == 1:\n                raise\n\ndef upload_fixed(storage, payload, request_id):\n    for attempt in range(2):\n        try:\n            return storage.put(payload, key=request_id)\n        except LostResponse:\n            if attempt == 1:\n                raise\n"
      }
    },
