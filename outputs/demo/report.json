  "decision_cards": [
    {
      "id": "retry-response-lost",
      "requirement_id": "R1",
      "problem": "上传接口偶尔收不到响应。调用方想自动重试，同时又不能多保存一份文件。如果从零设计，你会怎么做？",
      "hints": [
        "对调用方而言，两种情况都可能表现成超时：远端还没处理，或已经处理但响应没回来。你的方案能区分它们吗？",
        "假设网络超时后，调用方看不到远端的对象列表。要识别两次调用其实是同一次业务操作，哪个信号得跨尝试保持不变？"
      ],
      "constraints": [
        "远端第一次保存已成功，但响应丢失；客户端看到的是超时。",
        "重试复用同一个业务操作标识；能否安全重试，还取决于接收端是否按这个标识识别重复操作。"
      ],
      "reveal": {
        "explanation": "原实现每次都裸调用 put(payload)，远端无法分辨第二次是重试还是新上传。对照实现每次都传同一个 request_id；演示存储记录 key 和对象 ID，收到相同 key 时返回旧 ID，不再新增对象。关闭自动重试能避免由此产生的第二次写入，但超时后仍需查明是否成功。用稳定 ID 重试体验更好，但依赖接收端的去重契约与实现。",
        "references": [
          {
            "file": "service.py",
            "start": 11,
            "end": 21
          },
          {
            "file": "service.py",
            "start": 23,
            "end": 37
          }
        ],
        "tradeoffs": [
          "不自动重试：避免这次重复提交，但调用方仍需查明首次操作是否生效。",
          "使用稳定操作 ID 重试：保留自动恢复体验，但接收端必须识别重复请求。"
        ],
        "unknowns": [
          "仍未验证：真实供应商是否保证幂等键至少保留 24 小时（R3）；并发和重启恢复也不在本次覆盖范围。"
        ],
        "acceptance_checks": [
          "让第一次保存成功后丢掉响应；用同一个操作 ID 重试；确认只产生一个对象，且返回该对象的 ID。"
        ]
      },
